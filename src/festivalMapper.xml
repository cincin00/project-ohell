<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="festival">


	<select id="selectList" resultType="festival.festivalVO">
		select id,substr(start_date,1,10) start_date,substr(end_date,1,10) end_date,location,url,imgurl,substr(text,1,10),title,text from festival where id between #{startRow} and #{endRow}
	</select>
	
	<select id="selectCount" resultType="java.lang.String">
		select count(*) from festival
	</select>
