<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="coment">

	<insert id="add" parameterType="board.coment.ComentDataBean">
		insert into coment(coment_num,content_num,comenter,coment,like_num) values(coment_num.NEXTVAL,#{content_num},#{comenter},#{coment},0)
	</insert>
	
	<delete id="remove" parameterType="java.lang.String">
		delete from coment where id=#{id}
	</delete>
	
	<select id="getComent" resultType="board.coment.ComentDataBean">
		select * from coment where content_num=#{boardnum}
	</select>	
	
	<select id="getlist" resultType="board.coment.ComentDataBean">
		select * from coment
	</select>
	
	<select id="find" parameterType="String" resultType="board.coment.ComentDataBean">
		select * from coment where id=#{id}
	</select>
	
	<select id="getInfo" parameterType="String" resultType="hashmap">
		select * from coment where id=#{id}
	</select>
</mapper>